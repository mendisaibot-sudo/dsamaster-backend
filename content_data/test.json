      "content_json": {
        "blocks": [
          {
            "type": "heading",
            "level": 1,
            "text": "HTML Elements"
          },
          {
            "type": "text",
            "text": "An HTML element is defined by a start tag, content, and an end tag."
          },
          {
            "type": "list",
            "items": [
              "Start tag: <tagname>",
              "End tag: </tagname>",
              "Content goes between tags",
              "Void elements have no end tag"
            ]
          }
        ]
      },
      "code_examples": [
        {
          "language": "html",
          "code": "<p>This is a paragraph.</p>\n<div>\n    <h1>A heading</h1>\n</div>\n<br>\n<hr>",
          "description": "Element examples",
          "output": "Paragraph, heading, line break, rule"
        }
      ],
      "exercises": [
        {
          "type": "mcq",
          "question": "What closes an HTML element?",
          "options": [
            {
              "text": "The end tag",
              "correct": true
            },
            {
              "text": "The start tag",
              "correct": false
            },
            {
              "text": "DOCTYPE",
              "correct": false
            },
            {
              "text": "<html> tag",
              "correct": false
            }
          ],
          "correct_answer": "The end tag",
          "hint": "It has a forward slash.",
          "explanation": "End tags like </tagname> close elements.",
          "difficulty": "beginner"
        }
      ]
    },
