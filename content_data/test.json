      "title": "DOCTYPE Declaration",
      "slug": "html-doctype",
      "difficulty": "beginner",
      "estimated_minutes": 15,
      "order_index": 0,
      "content_json": {
        "blocks": [
          {
            "type": "heading",
            "level": 1,
            "text": "DOCTYPE Declaration"
          },
          {
            "type": "text",
            "text": "DOCTYPE tells the browser which HTML version to use. HTML5 uses <!DOCTYPE html>."
          },
          {
            "type": "list",
            "items": [
              "Must be first line",
              "HTML5 is shortest ever",
              "Ensures standards mode rendering"
            ]
          }
        ]
      },
      "code_examples": [
        {
          "language": "html",
          "code": "<!DOCTYPE html>\n<html>\n<head><title>Page</title></head>\n<body><p>Hello</p></body>\n</html>",
          "description": "HTML5 doctype",
          "output": "Standards mode rendering"
        }
      ],
      "exercises": [
        {
          "type": "mcq",
          "question": "What does DOCTYPE do?",
          "options": [
            {
              "text": "Declares HTML version",
              "correct": true
            },
            {
              "text": "Creates links",
              "correct": false
            },
            {
              "text": "Defines styles",
              "correct": false
            },
            {
              "text": "Runs scripts",
              "correct": false
            }
          ],
          "correct_answer": "Declares HTML version",
          "hint": "First line of any HTML file.",
          "explanation": "DOCTYPE declares the document type to the browser.",
          "difficulty": "beginner"
        }
      ]
    },
