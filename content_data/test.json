    {
      "topic_slug": "html-basics",
      "title": "What is HTML?",
      "slug": "html-what-is",
      "difficulty": "beginner",
      "estimated_minutes": 15,
      "order_index": 0,
      "content_json": {
        "blocks": [
          {
            "type": "heading",
            "level": 1,
            "text": "What is HTML?"
          },
          {
            "type": "text",
            "text": "HTML (HyperText Markup Language) is the standard markup language for creating web pages. It describes the structure using elements that tell the browser how to display content."
          },
          {
            "type": "list",
            "items": [
              "HTML = HyperText Markup Language",
              "Describes structure of web pages",
              "Uses elements to label content",
              "Created by Tim Berners-Lee in 1991"
            ]
          }
        ]
      },
      "code_examples": [
        {
          "language": "html",
          "code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>My First Page</title>\n</head>\n<body>\n    <h1>Hello, World!</h1>\n    <p>This is my first web page.</p>\n</body>\n</html>",
          "description": "Complete valid HTML5 document",
          "output": "Page displays heading and paragraph"
        }
      ],
      "exercises": [
        {
          "type": "mcq",
          "question": "What does HTML stand for?",
          "options": [
            {
              "text": "HyperText Markup Language",
              "correct": true
            },
            {
              "text": "HyperText Modern Language",
              "correct": false
            },
            {
              "text": "Home Tool Markup Language",
              "correct": false
            },
            {
              "text": "Hyper Transfer Markup Language",
              "correct": false
            }
          ],
          "correct_answer": "HyperText Markup Language",
          "hint": "Think about marking up text for hypertext.",
          "explanation": "HTML is HyperText Markup Language, the standard for web pages.",
          "difficulty": "beginner"
        }
      ]
    },
    {
      "topic_slug": "html-basics",
      "title": "HTML Elements",
      "slug": "html-elements",
      "difficulty": "beginner",
